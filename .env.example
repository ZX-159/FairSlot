# =============================================================================
# FairSlot — committed template (no secrets)
# Copy to .env.local for local development:
#   cp .env.example .env.local
# Production keys go in .env.prod (gitignored). See SETUP.md.
# =============================================================================

# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / public key (safe for the browser)
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-side API routes only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=
