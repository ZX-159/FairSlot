# =============================================================================
# FairSlot — local development template (no secrets committed)
#
#   cp .env.example .env.local
#   # paste keys from Supabase → Project Settings → API
#   npm install && npm run dev
#
# Vite loads .env.local automatically.
# The local /api middleware (vite.config.ts) also reads these for the server.
# =============================================================================

# Project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon / public key (safe in the browser)
VITE_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_ANON_KEY=your-anon-key

# service_role key (SERVER ONLY — never prefix with VITE_)
# Required for every /api write while RLS is enabled.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
